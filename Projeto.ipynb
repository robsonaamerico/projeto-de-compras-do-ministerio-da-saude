import pandas as pd

# Lista explícita com os nomes dos arquivos de 2020 a 2026
arquivos = [
    "2020.csv",
    "2021.csv",
    "2022.csv",
    "2023.csv",
    "2024.csv",
    "2025.csv",
    "2026.csv"
]

# Leitura e concatenação dos arquivos usando o separador ';'
dados = pd.concat(
    [pd.read_csv(arquivo, sep=";", low_memory=False) for arquivo in arquivos],
    ignore_index=True
)

# Exportação direta para o arquivo final unificado
dados.to_csv("todos_tratado.csv", index=False, sep=";")

print(f"Arquivo 'todos_tratado.csv' gerado com sucesso! Total de linhas: {len(dados):,}")
